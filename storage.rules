rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function gebruiker() {
      return request.auth != null && request.auth.token.email_verified == true &&
        (request.auth.token.email.lower() == "robin@mijnschoonmaker.com" || request.auth.token.email.lower() == "robin@mansard.nl" ||
         firestore.exists(/databases/(default)/documents/gebruikers/$(request.auth.token.email.lower()))) &&
        mfaOk();
    }
    // tweestapsverificatie: zie firestore.rules
    function mfaOk() {
      return !firestore.exists(/databases/(default)/documents/mfa/$(request.auth.token.email.lower())) ||
        firestore.get(/databases/(default)/documents/mfa/$(request.auth.token.email.lower())).data.get("aan", false) != true ||
        request.auth.token.auth_time in request.auth.token.get("mfa", []);
    }
    // back-ups: nooit vanuit de browser (alleen de server, via de functie backupNu)
    match /backups/{n} {
      allow read, write: if false;
    }
    match /assets/{id} {
      // lezen gaat via /_blob/ (server); uploaden alleen door gebruikers van het CRM
      // alleen een bekend bestand openen (geen lijst van alle bestanden: die is van alle bedrijven samen)
      allow get: if gebruiker();
      // alleen nieuwe bestanden; een bestaand bestand (ook van een ander bedrijf) kan niet worden overschreven of gewist
      allow create: if gebruiker() && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
